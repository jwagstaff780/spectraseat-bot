# Copy to .dev.vars for `npm run dev` (Cloudflare local runtime), or
# .env.local for `vercel dev`. Never commit the real values.
# In production: storefront vars go in Cloudflare Pages settings, agent
# vars in GitHub Actions secrets/variables — see README "Setup".

# --- Core ---
DATABASE_URL=
APP_URL=
STORE_NAME=SpectraSeat
SUPPORT_EMAIL=
# Shared secret for the GitHub Actions automation workflows.
CRON_SECRET=
# Password for /admin.html
ADMIN_TOKEN=

# --- Payments (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Supplier (CJdropshipping) ---
SUPPLIER=cj
CJ_API_KEY=

# --- AI copywriter (optional; falls back to cleaned supplier text) ---
ANTHROPIC_API_KEY=

# --- Customer email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="SpectraSeat <orders@yourdomain.com>"

# true = newly sourced products go live without review
AUTO_PUBLISH=false

# --- Multiple suppliers (comma-separated adapter names) ---
SUPPLIERS=cj

# --- Owner ---
# Where the sales manager agent sends the daily briefing.
OWNER_EMAIL=
# Signs review links (falls back to CRON_SECRET).
REVIEW_SECRET=

# --- Ads + social agents (Meta) ---
# off | dry_run | live. Keep dry_run until probe:meta passes and you've read the README.
ADS_MODE=dry_run
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PIXEL_ID=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=
META_API_VERSION=v23.0
